# Copy to a local .env — never commit real values.
# Grok live preview leaves these unset and uses embedded PGLite.

# APP_ENV=production
# NODE_ENV=production
# PORT=8080

# Postgres. When unset, the app uses embedded PGLite (preview).
# DATABASE_URL=postgres://user:pass@host:5432/linkmate

# Better Auth — 32+ random bytes. BETTER_AUTH_URL is the public origin.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://example.com

# Production-safe defaults when APP_ENV=production (or NODE_ENV=production + DATABASE_URL):
# ALLOW_BOOTSTRAP_ADMIN=false
# PAYMENTS_MODE=disabled
# ENABLE_DEMO_NETWORK=false
# ENABLE_SIMULATE_JOINS=false

# Preview / local (the app already defaults to these when not production):
# PAYMENTS_MODE=simulation
# ENABLE_DEMO_NETWORK=true
# ENABLE_SIMULATE_JOINS=true
